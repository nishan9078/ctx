{
  "name": "autonomous-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harness": "dist/apps/cli/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "harness": "tsx apps/cli/src/index.ts",
    "test:live": "HARNESS_LIVE=1 tsx --test tests/integration/live.test.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.166.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
